# Exporta las variables antes de iniciar uvicorn; no se carga .env automáticamente.
# Las rutas relativas se resuelven desde backend/.
CV_MODEL_PATH=models/yolov8n-doclaynet.pt
CV_TESSDATA_DIR=.runtime/tessdata
CV_TESSERACT_CMD=tesseract
CV_LANGUAGES=spa+eng
CV_DEVICE=cpu
CV_YOLO_CONFIDENCE=0.2
CV_YOLO_IMAGE_SIZE=1024
CV_REQUIRE_YOLO=false
CV_MAX_PAGES=10
CV_DPI=200
CV_OCR_TIMEOUT=30
CV_MAX_REGIONS=40
CV_MAX_CONCURRENT_JOBS=1
CV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
