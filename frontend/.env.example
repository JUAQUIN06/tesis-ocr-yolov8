# Vite redirige /api al backend tanto en desarrollo como en preview.
BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Opcional: URL pública de la API (incluye /api) cuando se aloja por separado.
# VITE_API_BASE_URL=https://servidor.example/api

# Tiempo máximo de espera del reconocimiento: 5 minutos por defecto.
VITE_ANALYSIS_TIMEOUT_MS=300000
